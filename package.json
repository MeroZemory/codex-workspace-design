{
  "name": "codex-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "Personal workspace for existing Codex CLI sessions",
  "author": "MeroZemory",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "probe:auth": "node scripts/probe-auth.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win zip",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:workspace": "node scripts/workspace-e2e.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "io.github.merozememory.codexworkspace",
    "productName": "Codex Workspace",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "src/desktop/**",
      "src/runtime/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  }
}
