# Track reviewed research and design artifacts only.
/*
!/.gitignore
!/README.md
!/*.md
!/*.json
!/*.mmd
!/licenses/
/licenses/*
!/licenses/codex-APACHE-2.0.txt
!/licenses/codex-NOTICE.txt
!/config-auth-verification/
/config-auth-verification/*
!/config-auth-verification/verification.json
!/config-auth-verification/schema/
/config-auth-verification/schema/*
!/config-auth-verification/schema/ChatgptAuthTokensRefreshParams.json
!/config-auth-verification/schema/ChatgptAuthTokensRefreshResponse.json
!/config-auth-verification/schema/v2/
/config-auth-verification/schema/v2/*
!/config-auth-verification/schema/v2/LoginAccountParams.json
!/src/
!/scripts/
!/test/
!/experiments/
/experiments/tmp*/
/experiments/*.log
!/package-lock.json
!/package.json
# Runtime and imported credentials must stay out even inside source directories.
**/auth.json
**/credentials.json
**/accounts.dpapi
**/ipc-token
**/workspace.json
**/.env
**/.env.*
